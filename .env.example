# SMTP for outgoing emails (holiday greetings + task-assignment notices).
# Leave blank to run senders in dry-run (they log instead of sending).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Jikoni <no-reply@jikoni.app>"
# Base URL of the app, used in notification email links (e.g. the Tasks page).
APP_URL=https://app.jikoni.app
# Direct Postgres URL (pooler) — used by data scripts. Server-only secret.
SUPABASE_DB_URL=
# Service-role key — server-only (data scripts + Vercel /api functions). Secret.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Sales CRM: M-Pesa (Safaricom Daraja) — used by /api/mpesa-* on Vercel ----
# Set these in the Vercel project env (and .env.local for local runs). Secrets.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public URL Safaricom posts the STK result to (your deployed function).
MPESA_CALLBACK_URL=https://app.jikoni.app/api/mpesa-callback
